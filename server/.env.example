PROJECT_NAME="Michael Krapes's API"
FRONTEND_URL=https://michael-krapes.vercel.app
SECRET_KEY=change-me

STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard.
# Subscribe to: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_...

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SERVER=
POSTGRES_PORT=5432
POSTGRES_DB=

# Live shipping rates — Shippo API token (shippo_test_... or shippo_live_...)
# Connect carriers (USPS/UPS/FedEx) in the Shippo dashboard.
SHIPPO_API_KEY=
# Studio ship-from address (required for quotes)
SHIP_FROM_NAME="Michael Krapes Studio"
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
# Default packed-box size per work (inches / lb). Override per work with Stripe
# product metadata: ship_length, ship_width, ship_height, ship_weight.
DEFAULT_PARCEL_LENGTH_IN=30
DEFAULT_PARCEL_WIDTH_IN=26
DEFAULT_PARCEL_HEIGHT_IN=6
DEFAULT_PARCEL_WEIGHT_LB=12

# Email via SMTP (Gmail: turn on 2-Step Verification, then create an App Password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Receives contact-form messages and new-order alerts
STUDIO_EMAIL=drkrapes@gmail.com

# Admin panel login (/admin). Create the hash with:
#   python -m app.core.auth "your-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
